# Database Connection (PostgreSQL / Supabase / Neon / PlanetScale)
DATABASE_URL="postgresql://username:password@localhost:5432/tokyo_trip_2027?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/tokyo_trip_2027?schema=public"

# App Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: API Secret for cron / sync
TRIP_SYNC_SECRET="your-secret-key-for-sync"
